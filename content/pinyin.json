  "rules": [
    {
      "id": "mark",
      "title": "Where the tone mark goes",
      "explain": "On a or e if there is one; on the o in ou; otherwise on the last vowel.",
      "practice": [
        { "prompt": "hao3", "choices": ["hǎo", "haǒ"], "answer": "hǎo" },
        { "prompt": "gou3", "choices": ["gǒu", "goǔ"], "answer": "gǒu" },
        { "prompt": "liu4", "choices": ["lìu", "liù"], "answer": "liù" }
      ]
    },
    {
      "id": "u-dots",
      "title": "ü loses its dots",
      "explain": "After j, q, x and y, ü is written u but still sounds like ü.",
      "practice": [
        { "prompt": "j + ü", "choices": ["ju", "jü"], "answer": "ju", "say": "ju1" },
        { "prompt": "q + ü", "choices": ["qü", "qu"], "answer": "qu", "say": "qu4" },
        { "prompt": "y + ü", "choices": ["yu", "yü"], "answer": "yu", "say": "yu2" }
      ]
    },
    {
      "id": "third-third",
      "title": "Two 3rd tones in a row",
      "explain": "The first one becomes a 2nd tone. 你好 is written nǐ hǎo but said ní hǎo.",
      "practice": [
        { "prompt": "你好 nǐ hǎo", "choices": ["ní hǎo", "nǐ hǎo"], "answer": "ní hǎo", "say": "ni2 hao3" },
        { "prompt": "很好 hěn hǎo", "choices": ["hěn hǎo", "hén hǎo"], "answer": "hén hǎo", "say": "hen2 hao3" },
        { "prompt": "水果 shuǐguǒ", "choices": ["shuíguǒ", "shuǐguǒ"], "answer": "shuíguǒ", "say": "shui2 guo3" }
      ]
    },
    {
      "id": "bu",
      "title": "不 bù before a 4th tone",
      "explain": "不 bù becomes bú before a 4th tone.",
      "practice": [
        { "prompt": "不是", "choices": ["bù shì", "bú shì"], "answer": "bú shì", "say": "bu2 shi4" },
        { "prompt": "不要", "choices": ["bú yào", "bù yào"], "answer": "bú yào", "say": "bu2 yao4" },
        { "prompt": "不好", "choices": ["bú hǎo", "bù hǎo"], "answer": "bù hǎo", "say": "bu4 hao3" }
      ]
    },
    {
      "id": "yi",
      "title": "一 yī changes too",
      "explain": "一 yī becomes yí before a 4th tone and yì before the other tones.",
      "practice": [
        { "prompt": "一个", "choices": ["yí gè", "yì gè"], "answer": "yí gè", "say": "yi2 ge4" },
        { "prompt": "一天", "choices": ["yí tiān", "yì tiān"], "answer": "yì tiān", "say": "yi4 tian1" },
        { "prompt": "一起", "choices": ["yì qǐ", "yí qǐ"], "answer": "yì qǐ", "say": "yi4 qi3" }
      ]
